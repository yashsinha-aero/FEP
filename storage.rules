rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isValidUploadOrDelete(studentId) {
      return request.auth != null 
        && request.auth.uid == studentId 
        && (request.resource == null || request.resource.size <= 1572864);
    }

    match /resumes/{studentId}/profile/{fileName} {
      allow read: if request.auth != null;
      allow write: if isValidUploadOrDelete(studentId);
    }

    match /resumes/{studentId}/{applicationId}/{fileName} {
      allow write: if isValidUploadOrDelete(studentId);
      allow read: if request.auth != null;
    }

    match /documents/{studentId}/{allPaths=**} {
      allow write: if isValidUploadOrDelete(studentId);
      allow read: if request.auth != null;
    }
  }
}


